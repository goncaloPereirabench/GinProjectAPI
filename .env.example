APP_ENV=development
PORT=8080
SHUTDOWN_TIMEOUT=10s

# For local no-database development, leave DATABASE_DSN empty.
# For Azure SQL, prefer encrypt=true and a least-privilege SQL user.
DATABASE_DSN=sqlserver://user:password@server.database.windows.net:1433?database=GinGrocery&encrypt=true
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=gin-grocery-api
JWT_ACCESS_TTL=15m

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20
